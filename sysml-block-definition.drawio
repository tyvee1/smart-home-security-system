        <mxCell id="note" value="Multiplicities are the capacities required by SHSS-F-023: 64 sensors, 16 cameras, 32 controllers. CloudServices is 0..1 because SHSS-F-026 requires the system to keep working without it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E6;strokeColor=#B38F2E;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="760" y="544" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="note3" value="Notation: filled diamond = composition, hollow triangle = generalization. Multiplicity is written at the part end of each composition." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E6;strokeColor=#B38F2E;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1480" y="544" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="note2" value="Specialization is shown only for Sensor. Camera, Controller and UserInterface vary by surface rather than by type, and are parameterised in their value compartments instead." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E6;strokeColor=#B38F2E;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1120" y="544" width="340" height="110" as="geometry"/></mxCell>
